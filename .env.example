# Токен бота MAX. В запрос уходит заголовком Authorization, без слова Bearer.
MAX_BOT_TOKEN=

# Ключ Gemini. Вставляется локально и не коммитится: .env лежит в gitignore.
GEMINI_API_KEY=

# Быстрая модель с разбором картинок. Имя можно сменить, не трогая код.
GEMINI_MODEL=gemini-2.5-flash

DATABASE_PATH=data/tutor.db
WEB_HOST=127.0.0.1
WEB_PORT=8000
