MAX_BOT_TOKEN=

GEMINI_API_KEY=

GEMINI_MODEL=gemma-4-31b-it
# Если основная отказала — по очереди. Через запятую.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite
# Квизы, пустое значение — GEMINI_MODEL.
GEMINI_QUIZ_MODEL=gemini-3.5-flash-lite

DATABASE_PATH=data/tutor.db
WEB_HOST=127.0.0.1
WEB_PORT=8000
CABINET_URL=

# HTTPS webhook на порту 443. Пусто — long polling.
# Нативные голосовые через polling часто приходят пустыми (баг MAX API);
# с webhook они доходят. Секрет: 5–256 символов A-Z a-z 0-9 _ -
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=

PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# Пусто - бот открыт всем, иначе id MAX через запятую
ALLOWED_USER_IDS=

# Сколько квизов в неделю показывать целью на главной кабинета (по умолчанию 5)
WEEK_QUIZ_GOAL=
